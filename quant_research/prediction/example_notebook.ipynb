   "source": [
    "# Stock Prediction Pipeline - End-to-End Example\n",
    "\n",
    "This notebook demonstrates the complete workflow for training and using the prediction pipeline that leverages the Quant Research Platform's microstructure and liquidity features."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, 'D:/Trading/quant_research')\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "\n",
    "from quant_research.prediction.pipeline import PredictionPipeline, PredictionPipelineConfig\n",
    "from quant_research.prediction.features.engineer import FeatureEngineer, FeatureConfig\n",
    "from quant_research.prediction.models.registry import ModelConfig, create_model, walk_forward_validation\n",
    "from quant_research.prediction.data.pipeline import DataPipeline, create_sample_data\n",
    "from quant_research.prediction.eval.metrics import compute_metrics, plot_predictions, backtest_strategy"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Configure the Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "config = PredictionPipelineConfig(\n",
    "    symbols=[\"SPY\", \"QQQ\", \"IWM\"],\n",
    "    start_date=\"2020-01-01\",\n",
    "    end_date=None,\n",
    "    target_horizon=1,\n",
    "    target_type=\"return\",\n",
    "    model_type=\"rf\",  # Random Forest\n",
    "    model_hyperparams={\"n_estimators\": 200, \"max_depth\": 5},\n",
    "    walk_forward_splits=5,\n",
    "    transaction_cost=0.001\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Run Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline = PredictionPipeline(config)\n",
    "results = pipeline.run()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Inspect Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for symbol, result in results.items():\n",
    "    print(f\"\\n=== {symbol} ===\")\n",
    "    print(f\"MSE: {result['metrics']['mse']:.6f}\")\n",
    "    print(f\"Directional Accuracy: {result['metrics']['directional_accuracy']:.2%}\")\n",
    "    print(f\"Correlation: {result['metrics']['correlation']:.4f}\")\n",
    "    print(f\"Backtest Sharpe: {result['backtest']['sharpe']:.3f}\")\n",
    "    print(f\"Backtest Return: {result['backtest']['annual_return']:.2%}\")\n",
    "    print(f\"Max Drawdown: {result['backtest']['max_drawdown']:.2%}\")\n",
    "    \n",
    "    if result['feature_importance'] is not None:\n",
    "        print(f\"\\nTop 10 Features:\")\n",
    "        print(result['feature_importance'].head(10).to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Visualize Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "symbol = \"SPY\"\n",
    "result = results[symbol]\n",
    "wf = result[\"walk_forward\"]\n",
    "\n",
    "fig = plot_predictions(wf.actuals, wf.predictions, title=f\"{symbol} Walk-Forward Predictions\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_feature_importance(result[\"feature_importance\"], top_n=15, title=f\"{symbol} Feature Importance\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_cumulative_returns(wf.actuals, wf.predictions, title=f\"{symbol} Strategy vs Buy & Hold\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Make Predictions on New Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save and load models\n",
    "pipeline.save_models(\"./saved_models.pkl\")\n",
    "\n",
    "# Load and predict\n",
    "loaded = PredictionPipeline.load_models(\"./saved_models.pkl\")\n",
    "\n",
    "import yfinance as yf\n",
    "ticker = yf.Ticker(\"SPY\")\n",
    "recent = ticker.history(period=\"60d\", interval=\"1d\")\n",
    "recent.columns = [c.lower() for c in recent.columns]\n",
    "\n",
    "pred = loaded.predict(\"SPY\", recent)\n",
    "print(f\"Next-day return prediction for SPY: {pred[0]:.4%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Using Microstructure & Liquidity Features (Advanced)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
